{
  "name": "career-alpha",
  "version": "0.2.0",
  "description": "AI-native career OS for asymmetric opportunity discovery, proof-of-work building, evidence auditing, positioning, interview defense, and market feedback.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "init": "node scripts/career-alpha.mjs init",
    "demo": "node scripts/career-alpha.mjs demo",
    "validate:skills": "python3 scripts/validate_skills.py",
    "validate:package": "python3 scripts/validate_package.py",
    "validate:node": "node scripts/validate_node_package.mjs",
    "validate": "npm run validate:skills && npm run validate:package && npm run validate:node",
    "test": "npm run validate"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "scripts",
    "assets",
    "docs",
    "examples",
    "references",
    ".codex-plugin",
    ".claude-plugin",
    ".opencode-plugin",
    ".trae-plugin",
    "README.md",
    "README_en.md",
    "LICENSE"
  ],
  "keywords": [
    "career",
    "job-search",
    "agent-skill",
    "career-alpha",
    "proof-of-work",
    "interview",
    "resume",
    "codex",
    "claude-code",
    "opencode",
    "traework"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lavine888/career-alpha.git"
  },
  "homepage": "https://github.com/lavine888/career-alpha",
  "engines": {
    "node": ">=20"
  }
}
